# systemd *user* unit: airpipe in the background. It creates the "AirPlay"
# output and plays to the speakers chosen with `airpipe use <speaker>`.
#
#   systemctl --user enable --now airpipe.service
#
# Then `airpipe status`, `airpipe use ...`, `airpipe stop` talk to it.
#
# Packages install this file to /usr/lib/systemd/user/. With `cargo install`,
# copy it to ~/.config/systemd/user/ and change ExecStart to
# %h/.cargo/bin/airpipe run.

[Unit]
Description=AirPlay output (airpipe)
After=pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
# A bare name is looked up in /usr/local/bin, /usr/bin, ... by systemd.
ExecStart=airpipe run
Restart=on-failure
RestartSec=5
# 3 = another airpipe is already running (e.g. `airpipe run` in a terminal):
# retrying would not help.
RestartPreventExitStatus=3
# Use airpipe=debug when troubleshooting (journalctl --user -u airpipe).
Environment=RUST_LOG=airpipe=info

[Install]
WantedBy=default.target
